    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "express-mysql-session": "^3.0.3",
    "helmet": "^8.0.0",
    "mssql": "^11.0.1",
    "mysql2": "^3.11.5",
    "node-fetch": "^2.7.0"
