{
  "name": "zalo-bot-platform",
  "version": "1.0.0",
  "description": "Self-hosted Zalo Bot management platform: member approval, bot management, webhooks, Gemini AI, custom message handlers and external DB connectors.",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
